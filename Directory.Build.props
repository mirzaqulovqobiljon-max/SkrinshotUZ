<Project>
  <!--
    Barcha loyihalar uchun umumiy sozlamalar.
    Talab: "dotnet build ogohlantirishlarsiz" — shuning uchun har qanday ogohlantirish xato hisoblanadi.
  -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Xatolik loglarida qator raqamlari bo'lsin, lekin alohida .pdb fayllar chiqmasin (natija — bitta .exe). -->
    <DebugType>embedded</DebugType>

    <!-- Versiya CI'da -p:Version=... orqali almashtiriladi -->
    <Version>1.0.1</Version>
    <Company>Skrinshot UZ</Company>
    <Product>Skrinshot UZ</Product>
    <Copyright>© 2026 Skrinshot UZ</Copyright>
    <NeutralLanguage>uz-Latn-UZ</NeutralLanguage>
  </PropertyGroup>
</Project>
