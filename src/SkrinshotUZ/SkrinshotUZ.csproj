<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows ilovasi (WinForms). Faqat Windows'da yig'iladi: CI — windows-latest. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SkrinshotUZ</AssemblyName>
    <RootNamespace>SkrinshotUZ</RootNamespace>
    <AssemblyTitle>Skrinshot UZ</AssemblyTitle>
    <Description>O'zbek maktablari uchun skrinshot dasturi</Description>

    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Per-Monitor DPI Aware v2. WinForms'da buni manifestda emas, shu xususiyat orqali yoqish tavsiya etiladi
      (manifestdagi dpiAwareness WFAC010 ogohlantirishini beradi).
    -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>

    <!-- Kam xotira (<40 MB maqsad): fon GC oqimi o'chiriladi, workstation GC. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>

    <!-- Bitta .exe ichiga faqat kerakli tillarning framework resurslari kiradi. -->
    <SatelliteResourceLanguages>uz-Latn-UZ;uz-Cyrl-UZ;ru</SatelliteResourceLanguages>

    <!-- Natija — faqat bitta .exe: kutubxonalarning .xml hujjatlari nashr qilinmaydi. -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Til/sana jadvallari uchun alohida ICU kutubxonasi (icu.dll) o'rniga Windows'ning o'zidagi NLS ishlatiladi:
      bir necha MB xotira tejaladi. Windows 10/11 da natija bir xil.
    -->
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>

  <!--
    Reklama serveri (Supabase): manzil va OMMAVIY kalit yig'ish vaqtida beriladi —
    CI'da GitHub → Settings → Secrets and variables → Actions → Variables: ADS_SUPABASE_URL, ADS_SUPABASE_KEY.
    Bo'sh bo'lsa reklama o'chiq va dastur internetga umuman chiqmaydi.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="AdsSupabaseUrl" Value="$(AdsSupabaseUrl)" />
    <AssemblyMetadata Include="AdsSupabaseKey" Value="$(AdsSupabaseKey)" />
  </ItemGroup>

  <!--
    Matnni aniqlash (OCR): Tesseract kutubxonalari (arxitekturaga mos) va til modellari .exe ICHIGA joylanadi —
    natija baribir bitta fayl, internet kerak emas. Fayllarni CI "OCR fayllarini tayyorlash" qadami ocr-files\ ga yuklaydi:
      ocr-files\x64\*.dll, ocr-files\x86\*.dll, ocr-files\tessdata\*.traineddata
    Papka yo'q bo'lsa (masalan, Linux'da Core testlari) — loyiha baribir yig'iladi, OCR tugmasi tushuntirish beradi.
  -->
  <PropertyGroup>
    <OcrFilesDir>$(MSBuildThisFileDirectory)..\..\ocr-files\</OcrFilesDir>
    <OcrArch Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</OcrArch>
    <OcrArch Condition="'$(OcrArch)' == ''">x64</OcrArch>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(OcrFilesDir)$(OcrArch)') And Exists('$(OcrFilesDir)tessdata')">
    <EmbeddedResource Include="$(OcrFilesDir)$(OcrArch)\*.dll" LogicalName="ocr/bin/%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="$(OcrFilesDir)tessdata\*.traineddata" LogicalName="ocr/tessdata/%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" LogicalName="SkrinshotUZ.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkrinshotUZ.Core\SkrinshotUZ.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows'ga bog'liq qismlar (ekranni olish, kesish, chop etish chizuvchisi) shu loyihada testlanadi. -->
    <InternalsVisibleTo Include="SkrinshotUZ.Windows.Tests" />
  </ItemGroup>

</Project>
